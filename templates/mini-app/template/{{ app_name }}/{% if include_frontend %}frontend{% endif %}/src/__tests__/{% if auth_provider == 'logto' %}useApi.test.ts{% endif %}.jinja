import { describe, it, expect, vi, beforeEach } from "vitest";
import { renderHook } from "@testing-library/react";

const mockGetAccessToken = vi.fn();
vi.mock("@logto/react", () => ({
  useLogto: () => ({
    getAccessToken: mockGetAccessToken,
  }),
}));

vi.mock("../config", () => ({
  LOGTO_API_RESOURCE: "https://api.test.dev",
}));

import { useApi } from "../hooks/useApi";

describe("useApi", () => {
  beforeEach(() => {
    vi.restoreAllMocks();
    mockGetAccessToken.mockResolvedValue("test-access-token");
    globalThis.fetch = vi.fn();
  });

  it("attaches Bearer token to requests", async () => {
    (globalThis.fetch as ReturnType<typeof vi.fn>).mockResolvedValue({
      ok: true,
      status: 200,
      json: () => Promise.resolve({ data: "test" }),
    });

    const { result } = renderHook(() => useApi());
    await result.current.apiFetch("/api/items");

    const fetchCall = (globalThis.fetch as ReturnType<typeof vi.fn>).mock.calls[0];
    const headers = fetchCall[1].headers as Headers;
    expect(headers.get("Authorization")).toBe("Bearer test-access-token");
  });

  it("sends X-Timezone header", async () => {
    (globalThis.fetch as ReturnType<typeof vi.fn>).mockResolvedValue({
      ok: true,
      status: 200,
      json: () => Promise.resolve({}),
    });

    const { result } = renderHook(() => useApi());
    await result.current.apiFetch("/api/items");

    const fetchCall = (globalThis.fetch as ReturnType<typeof vi.fn>).mock.calls[0];
    const headers = fetchCall[1].headers as Headers;
    expect(headers.get("X-Timezone")).toMatch(/^[A-Za-z_]+\/[A-Za-z_]+|UTC$/);
  });

  it("throws when token is unavailable", async () => {
    mockGetAccessToken.mockResolvedValue(null);

    const { result } = renderHook(() => useApi());
    await expect(result.current.apiFetch("/api/items")).rejects.toThrow(
      "Unable to get access token"
    );
  });

  it("throws sanitized error on non-OK response", async () => {
    (globalThis.fetch as ReturnType<typeof vi.fn>).mockResolvedValue({
      ok: false,
      status: 500,
      text: () => Promise.resolve("Internal Server Error"),
    });

    const { result } = renderHook(() => useApi());
    await expect(result.current.apiFetch("/api/items")).rejects.toThrow(
      "Request failed (500)"
    );
  });

  it("returns undefined for 204 No Content", async () => {
    (globalThis.fetch as ReturnType<typeof vi.fn>).mockResolvedValue({
      ok: true,
      status: 204,
    });

    const { result } = renderHook(() => useApi());
    const data = await result.current.apiFetch("/api/items");
    expect(data).toBeUndefined();
  });
});
