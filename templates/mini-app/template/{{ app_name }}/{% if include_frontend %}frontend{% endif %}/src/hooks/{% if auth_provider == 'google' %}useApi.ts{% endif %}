/**
 * API client hook for Google sign-in.
 *
 * Requests carry the HttpOnly session cookie (same origin) and, on writes,
 * the session's CSRF token. No Authorization header is ever sent from the
 * browser: Bearer credentials are for agents only.
 */

import { useCallback } from "react";
import { useAuth } from "../auth";

const SAFE_METHODS = new Set(["GET", "HEAD", "OPTIONS"]);

async function errorDetail(response: Response): Promise<string | undefined> {
  try {
    const body = await response.json();
    return typeof body?.detail === "string" ? body.detail : undefined;
  } catch {
    return undefined;
  }
}

export function useApi() {
  const { csrfToken } = useAuth();

  const apiFetch = useCallback(
    async <T = unknown>(path: string, options: RequestInit = {}): Promise<T> => {
      const method = (options.method ?? "GET").toUpperCase();
      const headers = new Headers(options.headers);
      headers.set("Content-Type", "application/json");
      headers.set("X-Timezone", Intl.DateTimeFormat().resolvedOptions().timeZone);
      if (!SAFE_METHODS.has(method) && csrfToken) {
        headers.set("X-CSRF-Token", csrfToken);
      }

      const response = await fetch(path, {
        ...options,
        method,
        headers,
        credentials: "same-origin",
      });

      if (!response.ok) {
        const detail = await errorDetail(response);
        if (response.status === 401) {
          const code = detail === "session_expired" ? "?error=session_expired" : "";
          window.location.assign(`/login${code}`);
        } else if (response.status === 403 && detail === "not_allowed") {
          window.location.assign("/login?error=not_allowed");
        }
        throw new Error(`Request failed (${response.status})`);
      }

      if (response.status === 204) {
        return undefined as T;
      }
      return response.json();
    },
    [csrfToken],
  );

  return { apiFetch };
}
