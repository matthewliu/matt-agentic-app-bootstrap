import { BrowserRouter, Route, Routes } from "react-router-dom";
import { AuthProvider, useAuth } from "./auth";
import ProtectedLayout from "./components/Layout";
import ThemeToggle from "./components/ThemeToggle";
import LoginPage from "./pages/LoginPage";

function App() {
  return (
    <AuthProvider>
      <AppRoutes />
    </AuthProvider>
  );
}

function AppRoutes() {
  const { status } = useAuth();
  if (status === "not_configured") {
    return <AuthNotConfigured />;
  }
  return (
    <BrowserRouter>
      <Routes>
        <Route path="/login" element={<LoginPage />} />
        <Route element={<ProtectedLayout />}>
          <Route path="/" element={<WelcomePage />} />
        </Route>
      </Routes>
    </BrowserRouter>
  );
}

function AuthNotConfigured() {
  return (
    <div className="relative flex min-h-screen items-center justify-center bg-bg-primary px-4">
      <div className="absolute right-md top-md">
        <ThemeToggle />
      </div>
      <div
        role="alert"
        className="w-full max-w-md rounded-lg bg-bg-secondary border border-border-subtle p-8 shadow-md text-center"
      >
        <h1 className="font-heading text-2xl font-bold text-text-primary mb-2">
          {{ app_name }}
        </h1>
        <p className="font-body font-medium text-text-primary mb-2">
          Sign-in is not configured for this deployment.
        </p>
        <p className="font-body text-text-secondary">
          The operator must set the Google sign-in settings on the server.
        </p>
      </div>
    </div>
  );
}

function WelcomePage() {
  return (
    <div className="text-center py-16">
      <h2 className="font-heading text-3xl font-bold text-text-primary mb-4">
        Welcome to {{ app_name }}
      </h2>
      <p className="text-text-secondary font-body">
        {{ app_description }}
      </p>
    </div>
  );
}

export default App;
