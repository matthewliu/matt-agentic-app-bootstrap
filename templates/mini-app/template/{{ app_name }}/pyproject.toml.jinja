[project]
name = "{{ app_name }}"
version = "0.1.0"
description = "{{ app_description }}"
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
    "sqlalchemy[asyncio]>=2.0",
    "asyncpg>=0.29",
    "alembic>=1.13",
    "pydantic-settings>=2.0",
    "pyjwt[crypto]>=2.8",
    "cryptography>=42.0",
    # Floor for Render's eMudhra CA advisory (see Dockerfile).
    "certifi>=2026.10.19",
    "httpx>=0.27",
    "requests>=2.31.0",
{% if auth_provider == 'google' %}    # Google sign-in (OpenID Connect). Stay on the tested Authlib minor.
    "authlib>=1.9.5,<1.10",
    # Authlib's HTTP client. Authlib uses httpx2 whenever it is installed and
    # plain httpx otherwise; installing it always keeps one code path.
    "httpx2>=2.10,<3",
    # Signs the session cookie (Starlette SessionMiddleware).
    "itsdangerous>=2.1",
{% endif %}{% if include_cli %}    # CLI runtime deps (R13): per-app CLI ships with the app.
    "typer>=0.12",
    "rich>=13",
    "filelock>=3",
{% endif %}]

{% if include_cli or include_db %}[project.scripts]
{% if include_cli %}{{ app_name }} = "app.cli.main:app"
{% endif %}{% if include_cli and include_backend %}# MCP server over stdio. Needs the `mcp` extra.
{{ app_name }}-mcp = "app.mcp_server:main"
{% endif %}{% if include_db %}# Render pre-deploy command. It takes no arguments (see app/db/migrate.py).
{{ app_name }}-migrate = "app.db.migrate:main"
{% endif %}
{% endif %}

[project.optional-dependencies]
{% if include_cli and include_backend %}# MCP server (app/mcp_server/). Kept out of the main deps so the deployed
# web image, which installs `.` without extras, does not carry it.
mcp = ["mcp>=2.3,<3"]
{% endif %}dev = [
    "pytest>=8.0",
    "pytest-asyncio>=0.23",
    "httpx>=0.27",
    "ruff>=0.5",
    "aiosqlite>=0.20",
    # tests/unit/test_render_blueprint.py parses render.yaml.
    "pyyaml>=6.0",
{% if include_cli and include_backend %}    "mcp>=2.3,<3",
{% endif %}]

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"

[tool.ruff]
target-version = "py312"
line-length = 100

# Pin the rule set explicitly. Relying on ruff's DEFAULT selection couples this
# app's CI to whatever ruff release `ruff>=0.5` resolves to: the defaults have
# grown over time (0.16 added B/UP/BLE/RET/PLR/PIE), so a green build could go
# red on an unrelated `pip install` with no code change. Name the rules instead.
[tool.ruff.lint]
# `I` (import sorting) is deliberately absent: several modules build their
# import block from Jinja conditionals, so the rendered order depends on
# which variant was generated and cannot be canonically sorted for all of
# them from one template. Re-add it only if those blocks stop being
# conditional.
select = ["E", "F", "B", "UP"]
ignore = [
    # FastAPI's whole dependency-injection design is function calls in argument
    # defaults (`Depends(...)`, `Security(...)`, `Header(...)`). B008 flags the
    # idiom itself, so it is wrong for every route and dependency in this app.
    "B008",
]

[tool.setuptools.packages.find]
include = ["app*"]

[build-system]
requires = ["setuptools>=68.0"]
build-backend = "setuptools.build_meta"
