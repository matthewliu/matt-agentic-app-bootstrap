"""Sample CRUD resource routes — replace with your own resource.

Each `operation_id` is a stable public name: the CLI (`app/cli/operations.py`)
and the MCP server use the same string. Do not rename one without the others.
"""

from fastapi import APIRouter, Depends, HTTPException, Query
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth.dependencies import get_or_create_user_profile
from app.db.engine import get_db
from app.db.models import UserProfile
from app.models.item import ItemCreate, ItemResponse, ItemUpdate
from app.services import item_service

router = APIRouter(tags=["items"])


@router.get("/items", response_model=list[ItemResponse], operation_id="items_list")
async def list_items(
    skip: int = Query(0, ge=0),
    limit: int = Query(20, ge=1, le=100),
    profile: UserProfile = Depends(get_or_create_user_profile),
    db: AsyncSession = Depends(get_db),
):
    """List items with pagination, scoped to the current user."""
    return await item_service.get_items(db, profile.user_id, skip=skip, limit=limit)


@router.post(
    "/items", response_model=ItemResponse, status_code=201, operation_id="items_create"
)
async def create_item(
    data: ItemCreate,
    profile: UserProfile = Depends(get_or_create_user_profile),
    db: AsyncSession = Depends(get_db),
):
    """Create a new item owned by the current user."""
    return await item_service.create_item(db, profile.user_id, data)


@router.get("/items/{item_id}", response_model=ItemResponse, operation_id="items_get")
async def get_item(
    item_id: str,
    profile: UserProfile = Depends(get_or_create_user_profile),
    db: AsyncSession = Depends(get_db),
):
    """Get a single item by ID, scoped to the current user."""
    item = await item_service.get_item(db, profile.user_id, item_id)
    if item is None:
        raise HTTPException(status_code=404, detail="Not found")
    return item


@router.put("/items/{item_id}", response_model=ItemResponse, operation_id="items_update")
async def update_item(
    item_id: str,
    data: ItemUpdate,
    profile: UserProfile = Depends(get_or_create_user_profile),
    db: AsyncSession = Depends(get_db),
):
    """Update an existing item owned by the current user."""
    item = await item_service.get_item(db, profile.user_id, item_id)
    if item is None:
        raise HTTPException(status_code=404, detail="Not found")
    return await item_service.update_item(db, item, data)


@router.delete("/items/{item_id}", status_code=204, operation_id="items_delete")
async def delete_item(
    item_id: str,
    profile: UserProfile = Depends(get_or_create_user_profile),
    db: AsyncSession = Depends(get_db),
):
    """Delete an item owned by the current user."""
    item = await item_service.get_item(db, profile.user_id, item_id)
    if item is None:
        raise HTTPException(status_code=404, detail="Not found")
    await item_service.delete_item(db, item)
