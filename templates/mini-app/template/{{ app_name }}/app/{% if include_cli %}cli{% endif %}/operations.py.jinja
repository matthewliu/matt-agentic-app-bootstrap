"""Typed operations shared by the `{{ app_name }}` CLI and MCP server.

Each operation has one stable ID. The same string is the FastAPI
``operation_id`` on the route, the entry in ``agent-context --json``, and
the MCP tool name. Inputs and outputs are Pydantic models; the item models
are the API's own request and response models from ``app/models/item.py``.

``run()`` is the only way the CLI and the MCP server call the app: it
validates the input, sends one HTTP request through ``app.cli.client``, and
validates the response. Nothing here opens the database, so the API's auth
and per-user scoping always apply.

To expose a new API route to agents: give the route an ``operation_id``,
add an ``Operation`` here, then add a CLI command and (only if agents
should have it) an MCP tool.
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Literal
from urllib.parse import quote

from pydantic import BaseModel, ValidationError

from app.cli.client import {{ python_package_name.replace('_', ' ').title().replace(' ', '') }}Client, {{ python_package_name.replace('_', ' ').title().replace(' ', '') }}ClientError
{% if include_backend %}
import uuid

from pydantic import ConfigDict, Field, model_validator

from app.models.item import ItemCreate, ItemResponse, ItemUpdate
{% endif %}

{% set ClientCls = python_package_name.replace('_', ' ').title().replace(' ', '') + 'Client' %}
{% set ClientErr = ClientCls + 'Error' %}
# read: no data change. write: creates or changes data. destructive: deletes
# data; never offered as an MCP tool.
Access = Literal["read", "write", "destructive"]


@dataclass(frozen=True)
class Operation:
    id: str
    summary: str
    method: Literal["GET", "POST", "PUT", "DELETE"]
    path: str
    input_model: type[BaseModel]
    output_model: type[BaseModel]
    access: Access
    mcp_tool: bool
    # Input fields that fill `{name}` placeholders in `path`.
    path_params: tuple[str, ...] = ()
    # When the API returns a bare JSON list, wrap it under this key so every
    # output is an object (MCP structured output must be an object).
    list_key: str | None = None
{% if include_backend %}


# ---------------------------------------------------------------------------
# Item inputs and outputs. Limits match app/routes/items.py and
# app/models/item.py; a test compares them with the OpenAPI document.
# ---------------------------------------------------------------------------


class ItemsListInput(BaseModel):
    model_config = ConfigDict(extra="forbid")

    skip: int = Field(0, ge=0, description="Number of items to skip (newest first).")
    limit: int = Field(20, ge=1, le=100, description="Maximum number of items to return.")


class ItemIdInput(BaseModel):
    model_config = ConfigDict(extra="forbid")

    item_id: uuid.UUID = Field(..., description="Item ID (a UUID).")


class ItemsCreateInput(ItemCreate):
    model_config = ConfigDict(extra="forbid")


class ItemsUpdateInput(ItemUpdate):
    """Item ID plus the fields to change. Fields left out stay as they are."""

    model_config = ConfigDict(extra="forbid")

    item_id: uuid.UUID = Field(..., description="Item ID (a UUID).")

    @model_validator(mode="after")
    def _check_fields(self) -> ItemsUpdateInput:
        changed = self.model_fields_set - {"item_id"}
        if not changed:
            raise ValueError("give at least one field to change (name or description)")
        # The API stores an explicit null; a null name breaks a NOT NULL column.
        if "name" in changed and self.name is None:
            raise ValueError("name cannot be null")
        return self


class ItemsListOutput(BaseModel):
    items: list[ItemResponse]


class ItemsDeleteOutput(BaseModel):
    deleted: bool
    item_id: str
{% endif %}


