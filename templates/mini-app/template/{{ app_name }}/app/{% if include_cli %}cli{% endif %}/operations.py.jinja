def parse_input(op_id: str, payload: dict[str, Any]) -> BaseModel:
    """Validate ``payload`` for ``op_id``. Raises a typed client error (exit 1)."""
    op = OPERATIONS[op_id]
    try:
        return op.input_model.model_validate(payload)
    except ValidationError as exc:
        problems = "; ".join(
            f"{'.'.join(str(p) for p in err['loc']) or 'input'}: {err['msg']}"
            for err in exc.errors()
        )
        raise {{ ClientErr }}(
            exit_code=1,
            message=f"invalid input for {op_id}: {problems}",
            error_code="invalid_input",
        ) from exc


def run(op_id: str, client: {{ ClientCls }}, payload: dict[str, Any]) -> dict[str, Any]:
    """Validate, call the API, validate the response; return JSON-ready data."""
    op = OPERATIONS[op_id]
    data = parse_input(op_id, payload)

    path = op.path
    for name in op.path_params:
        path = path.replace("{" + name + "}", quote(str(getattr(data, name)), safe=""))
    # Only fields the caller set; an explicit null on update clears a column.
    fields = data.model_dump(mode="json", exclude_unset=True, exclude=set(op.path_params))

    if op.method == "GET":
        # Query values keep their defaults so the request is explicit.
        query = data.model_dump(mode="json", exclude=set(op.path_params))
        raw = client.get(path, params=query or None)
    elif op.method == "POST":
        raw = client.post(path, json=fields)
    elif op.method == "PUT":
        raw = client.put(path, json=fields)
    else:
        client.delete(path)
        raw = {"deleted": True, "item_id": str(getattr(data, op.path_params[0]))}

    if op.list_key and isinstance(raw, list):
        raw = {op.list_key: raw}
    try:
        result = op.output_model.model_validate(raw)
    except ValidationError as exc:
        raise {{ ClientErr }}(
            exit_code=3,
            message=f"unexpected response shape for {op_id}",
            error_code="invalid_response",
        ) from exc
    return result.model_dump(mode="json")


def describe() -> list[dict[str, Any]]:
    """Machine-readable list of operations for ``agent-context --json``."""
    return [
        {
            "id": op.id,
            "summary": op.summary,
            "access": op.access,
            "method": op.method,
            "path": op.path,
            # default: always an MCP tool. opt_in: only when the server runs
            # with the write opt-in. never: CLI only.
            "mcp_exposure": (
                "never" if not op.mcp_tool else "default" if op.access == "read" else "opt_in"
            ),
            "input_schema": op.input_model.model_json_schema(),
            "output_schema": op.output_model.model_json_schema(),
        }
        for op in OPERATIONS.values()
    ]
