# Mirror of agentic_core/agent_context.py — keep in sync.
# When editing one, edit the other. Re-extract to shared package in v2 (see R16).
# App-specific exceptions, NOT mirrored: the `operations` key (from
# app/cli/operations.py) and the auth text that depends on AUTH_PROVIDER.
"""Agent-context introspection — emit the v1 envelope from this CLI's Typer app.

Coding agents read `{{ app_name }} agent-context --json` once per session to
discover every command, arg, option, and exit-code contract — without
hard-coding command names in agent prompts.

The shape is the agent-context v1 envelope::

    {
      "schema_version": 1,
      "tool": "{{ app_name }}",
      "version": "<__version__>",
      "auth": {...},
      "commands": [
        {
          "name": "<group> <command>",
          "description": "<one-line help>",
          "args": [...],
          "options": [...],
          "examples": []
        },
        ...
      ],
      "error_codes": [
        {"code": 0, "meaning": "Success"},
        ...
      ]
    }

Per spec §B2, exit codes 0-5 are the contract every per-app CLI advertises.
Walking ``app.registered_commands`` (top-level) and ``app.registered_groups``
(sub-Typers, one level deep) mirrors ``agentic-core``'s own pattern —
change here and in ``agentic_core/agent_context.py`` together until v2
extracts a shared package (see R16).
"""

from __future__ import annotations

import inspect
from typing import Any

import typer

from app.cli import operations
from app.cli.client import AUTH_PROVIDER


# Fixed exit-code contract — keep aligned with `client.py`'s error mapping
# and spec §B2 (0 success, 1 user, 2 auth, 3 server/app, 4 network, 5 misconfig).
ERROR_CODES: list[dict[str, Any]] = [
    {"code": 0, "meaning": "Success"},
    {"code": 1, "meaning": "User error / invalid input"},
    {"code": 2, "meaning": "Authentication failed"},
    {"code": 3, "meaning": "Application or server error"},
    {"code": 4, "meaning": "Network error"},
    {"code": 5, "meaning": "Misconfiguration"},
]


# Slug glossary — mirrors ``agentic_core/agent_context.py`` SLUG_GLOSSARY.
# Documents the three string shapes a slug morphs into inside the generated
# app + the per-app envelope. Agents reading this CLI's agent-context
# otherwise have to reverse-engineer the env-var prefix from looking at
# the generated source. ``slug`` is the raw input, ``APP_UPPER`` is the
# env-var prefix (used by ``client.py``'s ``_build_client`` and ``.env.example``),
# and ``App-Name-Title`` is the human-readable form (README headings, Logto
# application display name).
SLUG_GLOSSARY: dict[str, str] = {
    "slug": (
        "Raw user-supplied identifier (e.g. ``{{ app_name }}``); lowercase, "
        "matches ``^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$``. Used as the directory "
        "name, GitHub repo name, {{ 'Render service name' if deploy_target == 'render' else 'Railway project name' }}, and Logto application "
        "name."
    ),
    "APP_UPPER": (
        "Underscored, uppercased form (e.g. ``{{ app_name.replace('-', '_').upper() }}``). "
        "Used as the env-var prefix consumed by this CLI's ``client.py`` and "
        "by ``.env.example`` / the FastAPI runtime config."
    ),
    "App-Name-Title": (
        "Title-cased, hyphen-preserving form (e.g. "
        "``{{ app_name.replace('-', ' ').title().replace(' ', '-') }}``). "
        "Used in generated README headings and the Logto application display name."
    ),
}


