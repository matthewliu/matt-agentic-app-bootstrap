"""Application configuration via environment variables."""

from pathlib import Path

from pydantic_settings import BaseSettings

# {% if auth_provider == 'google' %}Shared platform settings for every sibling app live here. Google sign-in and
# agent key settings never load from it (see AuthSettings below).{% else %}Shared platform credentials (Logto M2M, Railway token) live here{% endif %}
_SHARED_ENV = Path.home() / ".agentic-apps.env"


class Settings(BaseSettings):
    """Application settings loaded from environment variables with .env fallback."""

    app_name: str = "{{ app_name }}"
    app_version: str = "0.1.0"

    # Database
    database_url: str = "postgresql+asyncpg://localhost:5432/{{ python_package_name }}"

{% if auth_provider == 'logto' %}    # Logto auth
    logto_endpoint: str = "{{ logto_endpoint }}"
    logto_app_id: str = ""
    logto_app_secret: str = ""
    # Must match the indicator agentic_core.bootstrap.logto provisions:
    # `https://<slug>.<domain>/api`. An `api.<slug>` form fails every
    # `aud` check on every request.
    logto_api_resource: str = "https://{{ app_name }}.{{ platform_domain }}/api"

    # Logto M2M agent credentials (for agent-to-app access via client_credentials grant)
    logto_m2m_agent_app_id: str = ""
    logto_m2m_agent_app_secret: str = ""

    # Logto native app ID (for mobile apps — update redirect URIs in Logto before use)
    logto_native_app_id: str = ""

{% endif %}    # CORS
    cors_origins: str = "http://localhost:3000,http://localhost:5173"
    # Render sets this on every web service (e.g. https://<slug>.onrender.com).
    render_external_url: str = ""

    @property
    def async_database_url(self) -> str:
        """Rewrite DATABASE_URL for SQLAlchemy async (postgresql+asyncpg://)."""
        url = self.database_url
        if url.startswith("postgresql://"):
            return url.replace("postgresql://", "postgresql+asyncpg://", 1)
        if url.startswith("postgres://"):
            return url.replace("postgres://", "postgresql+asyncpg://", 1)
        return url

    @property
    def cors_origins_list(self) -> list[str]:
        """Parse comma-separated CORS origins into a list.

        An explicit CORS_ORIGINS (env var or env file) always wins. Without it,
        a Render deploy allows only its own URL, never the localhost defaults.
        """
        if "cors_origins" not in self.model_fields_set and self.render_external_url:
            return [self.render_external_url.strip()]
        return [origin.strip() for origin in self.cors_origins.split(",") if origin.strip()]

    model_config = {
        "env_file": (str(_SHARED_ENV), ".env"),
        "env_file_encoding": "utf-8",
        "extra": "ignore",  # shared env has vars not in this app's schema
    }


settings = Settings()
{% if auth_provider == 'google' %}

class AuthSettings(BaseSettings):
    """Google sign-in and agent key settings.

    These load from the process environment and this app's own `.env` only.
    They never load from the shared `~/.agentic-apps.env`, so one app's OAuth
    client, allowlist, or agent keys can never configure another app.
    app/auth/middleware.py decides which of them are required.
    """

    # OAuth client of type "Web application" in Google Cloud Console.
    google_client_id: str = ""
    google_client_secret: str = ""
    # Signs the session cookie. At least 32 characters. Render generates it.
    session_secret: str = ""
    # Comma-separated emails that may sign in. Empty means nobody.
    auth_allowed_emails: str = ""
    # Public base URL, e.g. https://my-app.onrender.com. Optional on Render,
    # which sets RENDER_EXTERNAL_URL. Set it when you add a custom domain.
    app_base_url: str = ""
    render_external_url: str = ""
    # A session ends this many seconds after sign-in, whatever activity.
    session_max_age_seconds: int = 8 * 60 * 60
    # JSON list of agent key entries (hashes only). See app/auth/agent_keys.py.
    agent_credentials: str = ""

    model_config = {
        "env_file": ".env",
        "env_file_encoding": "utf-8",
        "extra": "ignore",
    }


auth_settings = AuthSettings()
{% endif %}