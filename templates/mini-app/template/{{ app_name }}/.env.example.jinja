# {{ app_name }} environment variables
# Copy this file to .env and fill in the values.
#
# Placeholder conventions (Invariant 8 — never ship real secrets):
#   <set-in-host>            runtime-only secret; set it as a service
#                            variable on the deploy host ({{ 'Render' if deploy_target == 'render' else 'Railway' }}),
#                            not in a local .env
{% if deploy_target == 'railway' %}#   <generated-by-scaffold>  populated by `agentic-core create-app`
#                            when the per-app Logto client is provisioned
{% endif %}#   empty (=)                user-supplied
{% if deploy_target == 'render' and auth_provider == 'logto' %}#
# Auth is not configured for this app yet. No Logto application exists,
# so the Logto app IDs stay empty. While LOGTO_APP_ID is empty, protected
# API routes return 503 auth_not_configured.
{% elif auth_provider == 'google' %}#
# Sign-in uses Google. Until GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# SESSION_SECRET, AUTH_ALLOWED_EMAILS, and the base URL are all set,
# protected API routes return 503 auth_not_configured. The Google and agent
# key settings load only from this .env and the process environment, never
# from the shared ~/.agentic-apps.env.
{% endif %}#
# We use angle-bracket placeholders (with hyphens, not underscores) so
# that the entropy gate (/[A-Za-z0-9+/=_]{32,}/) sees a break in the
# character run — placeholders are otherwise easy to false-positive
# against because the gate's character class includes `=` and `_`.
#
# Invariant 4: this file MUST NOT reference the agentic-core admin /
# Logto Management API credentials. Those live ONLY in the encrypted
# keystore and never reach a generated app's runtime. See
# docs/SECURITY.md for the full per-app token isolation model.

{% if include_db %}# Database: the local Postgres from compose.yaml. Start it with
# `docker compose up -d db`. These are fixed local values, not secrets.
# The deploy host sets its own DATABASE_URL; never copy this value there.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{ app_name }}
{% else %}# Database (this app variant has no database)
DATABASE_URL=
{% endif %}
{% if auth_provider == 'logto' %}# Logto Auth (this app's per-app M2M + SPA clients)
LOGTO_ENDPOINT={{ logto_endpoint }}
LOGTO_APP_ID={% if deploy_target == 'railway' %}<generated-by-scaffold>{% endif %}
LOGTO_APP_SECRET=<set-in-host>
# Must be byte-identical to the indicator created by
# agentic_core.bootstrap.logto (`https://<slug>.<domain>/api`), or every
# token fails the `aud` check.
LOGTO_API_RESOURCE=https://{{ app_name }}.{{ platform_domain }}/api
{% else %}# Google sign-in. Create an OAuth client of type "Web application" in
# Google Cloud Console. Local redirect URI: <APP_BASE_URL>/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SESSION_SECRET=
# Comma-separated emails that may sign in. Empty means nobody.
AUTH_ALLOWED_EMAILS=
# Where people open the app. On Render, leave it unset (RENDER_EXTERNAL_URL
# is used) unless you add a custom domain.{% if include_frontend %} With the Vite dev server, use
# http://localhost:5173.{% endif %}
APP_BASE_URL=http://localhost:8000
# Agent keys for the CLI and MCP server: a JSON list of hashes from
# `python -m app.auth.agent_keys new`. Empty means agents cannot sign in.
AGENT_CREDENTIALS=
{% endif %}
{% if deploy_target == 'render' %}# CORS (comma-separated origins). On Render, leave CORS_ORIGINS unset:
# the app then allows only its own RENDER_EXTERNAL_URL.
{% else %}# CORS (comma-separated origins — production domain set on Railway automatically)
{% endif %}CORS_ORIGINS=http://localhost:5173,http://localhost:8000
{% if include_frontend and auth_provider == 'logto' %}

# Native app for mobile (placeholder ID — update in Logto before mobile launch)
LOGTO_NATIVE_APP_ID={% if deploy_target == 'railway' %}<generated-by-scaffold>{% endif %}
{% endif %}
