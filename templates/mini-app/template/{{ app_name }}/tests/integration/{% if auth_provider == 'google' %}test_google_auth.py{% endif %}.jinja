async def test_session_expires_after_max_age(google, google_client, monkeypatch):
    await sign_in(google_client, google)
    later = time.time() + 8 * 60 * 60 + 5
    monkeypatch.setattr(middleware, "time", SimpleNamespace(time=lambda: later))
    response = await google_client.get("/api/items")
    assert response.status_code == 401
    assert response.json() == {"detail": "session_expired"}


async def test_removing_an_email_ends_access_at_once(
    google, google_client, configured, monkeypatch
):
    await sign_in(google_client, google)
    assert (await google_client.get("/api/items")).status_code == 200
    monkeypatch.setattr(configured, "auth_allowed_emails", "friend@example.com")
    response = await google_client.get("/api/items")
    assert response.status_code == 403
    assert response.json() == {"detail": "not_allowed"}


@pytest.mark.parametrize("header", [None, "", "wrong-token"])
async def test_write_without_matching_csrf_token_is_refused(google, google_client, header):
    await sign_in(google_client, google)
    headers = {} if header is None else {"X-CSRF-Token": header}
    response = await google_client.post("/api/items", json={"name": "x"}, headers=headers)
    assert response.status_code == 403
    assert response.json() == {"detail": "csrf_failed"}


async def test_no_session_gets_401(configured, google_client):
    response = await google_client.get("/api/items")
    assert response.status_code == 401
    assert response.json() == {"detail": "not_authenticated"}


async def test_forged_cookie_is_ignored(configured, google_client):
    google_client.cookies.set("session", "eyJ1aWQiOiAiZ29vZ2xlOjEifQ==.forged.sig")
    response = await google_client.get("/api/items")
    assert response.status_code == 401


async def test_logout_needs_csrf_and_ends_the_session(google, google_client):
    await sign_in(google_client, google)
    refused = await google_client.post("/auth/logout")
    assert refused.status_code == 403
    token = await csrf_token(google_client)
    done = await google_client.post("/auth/logout", headers={"X-CSRF-Token": token})
    assert done.status_code == 204
    after = await google_client.get("/api/items")
    assert after.status_code == 401
    assert after.json() == {"detail": "not_authenticated"}


