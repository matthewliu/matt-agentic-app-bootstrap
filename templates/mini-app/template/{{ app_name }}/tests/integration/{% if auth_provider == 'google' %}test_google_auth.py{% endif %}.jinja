@pytest.mark.parametrize(
    "value",
    ["//evil.example", "/\\evil.example", "/ok\\..\\evil", "https://evil.example",
     "javascript:alert(1)", "/line\nbreak", "", None, "relative"],
)
def test_unsafe_next_falls_back_to_root(value):
    assert auth_routes.safe_next(value) == "/"


def test_safe_next_keeps_same_app_paths():
    assert auth_routes.safe_next("/items?page=2#top") == "/items?page=2#top"


async def test_open_redirect_attempt_lands_on_root(google, google_client):
    response = await sign_in(google_client, google, next_path="//evil.example")
    assert response.headers["location"] == "/"


async def test_login_on_another_host_moves_to_the_base_host(configured):
    transport = ASGITransport(app=auth_routes_app())
    async with AsyncClient(transport=transport, base_url="http://127.0.0.1:8000") as other:
        response = await other.get("/auth/login", params={"next": "/items"})
        assert response.status_code == 302
        assert response.headers["location"] == (
            "http://localhost:8000/auth/login?next=%2Fitems&hop=1"
        )
        assert "set-cookie" not in response.headers
        looped = await other.get("/auth/login", params={"next": "/items", "hop": "1"})
        assert looped.status_code == 400
        assert looped.json() == {"detail": "base_url_host_mismatch"}


def auth_routes_app() -> FastAPI:
    """A bare app with the auth routes and session middleware, built now."""
    bare = FastAPI()
    bare.add_middleware(SessionMiddleware, **middleware.session_middleware_kwargs())
    bare.include_router(auth_routes.router)
    return bare


async def test_https_cookie_is_secure_and_host_prefixed(google, configured, monkeypatch):
    monkeypatch.setattr(configured, "app_base_url", "https://gdemo.example.com")
    transport = ASGITransport(app=auth_routes_app())
    async with AsyncClient(transport=transport, base_url="https://gdemo.example.com") as c:
        response = await c.get("/auth/login")
    assert response.status_code == 302
    cookie = response.headers["set-cookie"].lower()
    assert cookie.startswith("__host-session=")
    assert "secure" in cookie and "httponly" in cookie and "samesite=lax" in cookie
    assert "path=/" in cookie and "domain=" not in cookie


