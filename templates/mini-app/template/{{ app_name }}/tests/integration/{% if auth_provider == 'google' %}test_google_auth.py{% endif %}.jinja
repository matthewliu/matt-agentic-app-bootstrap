# Fail closed while not configured
# ---------------------------------------------------------------------------


@pytest.mark.parametrize(
    ("setting", "value"),
    [
        ("google_client_id", ""),
        ("google_client_secret", ""),
        ("session_secret", ""),
        ("session_secret", "too-short"),
        ("session_secret", " " * 40),
        ("session_max_age_seconds", 0),
        ("auth_allowed_emails", ""),
        ("auth_allowed_emails", " , "),
        ("app_base_url", ""),
        ("app_base_url", "http://gdemo.example.com"),
        ("app_base_url", "https://gdemo.example.com/sub/path"),
        ("app_base_url", "https://[broken"),
        ("app_base_url", "https://gdemo.example.com:bad"),
    ],
)
async def test_missing_or_invalid_setting_returns_503_everywhere(
    configured, google_client, monkeypatch, setting, value
):
    monkeypatch.setattr(configured, setting, value)
    requests = [
        ("GET", "/api/items", {}),
        ("GET", "/api/items", {"Authorization": "Bearer agk.cli.x"}),
        ("POST", "/api/items", {}),
        ("GET", "/auth/login", {}),
        ("GET", "/auth/callback", {}),
        ("GET", "/auth/session", {}),
        ("POST", "/auth/logout", {}),
    ]
    google_client.cookies.set("session", "forged-cookie")
    for method, path, headers in requests:
        response = await google_client.request(method, path, headers=headers)
        assert response.status_code == 503, (method, path, response.text)
        assert response.json() == {"detail": "auth_not_configured"}


