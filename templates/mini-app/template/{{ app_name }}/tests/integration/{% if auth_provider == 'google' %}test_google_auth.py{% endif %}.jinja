async def test_login_redirect_uses_code_flow_pkce_and_least_scopes(google, google_client):
    params = await start_login(google_client, google)
    assert params["response_type"] == "code"
    assert params["client_id"] == google_fake.CLIENT_ID
    assert params["scope"] == "openid email"
    assert params["redirect_uri"] == "http://localhost:8000/auth/callback"
    assert params["code_challenge_method"] == "S256"
    assert len(params["code_challenge"]) == 43
    assert params["state"] and params["nonce"]
    assert params["prompt"] == "select_account"


async def test_sign_in_sets_session_and_reports_identity(google, google_client):
    response = await sign_in(google_client, google, next_path="/items?page=2")
    assert response.status_code == 302
    assert response.headers["location"] == "/items?page=2"
    set_cookie = response.headers["set-cookie"].lower()
    assert "httponly" in set_cookie and "samesite=lax" in set_cookie
    # PKCE: the fake token endpoint received the verifier (it checks the hash).
    assert google.token_requests[0]["code_verifier"]

    me = await google_client.get("/auth/session")
    assert me.status_code == 200
    body = me.json()
    assert body["user_id"] == google_fake.OWNER_ID
    assert body["email"] == google_fake.OWNER_EMAIL
    assert body["auth_method"] == "session"
    assert len(body["csrf_token"]) >= 32
    # The browser never receives a Google token.
    assert "ya29" not in me.text and "eyJ" not in me.text


async def test_signed_in_user_reads_and_writes_with_csrf(google, google_client):
    await sign_in(google_client, google)
    token = await csrf_token(google_client)

    created = await google_client.post(
        "/api/items", json={"name": "first"}, headers={"X-CSRF-Token": token}
    )
    assert created.status_code == 201, created.text
    listed = await google_client.get("/api/items")
    assert listed.status_code == 200
    assert [item["name"] for item in listed.json()] == ["first"]


