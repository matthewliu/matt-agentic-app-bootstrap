# ---------------------------------------------------------------------------
# Callback failures never create a session
# ---------------------------------------------------------------------------


@pytest.mark.parametrize(
    ("overrides", "expected"),
    [
        ({"aud": "someone-else.apps.googleusercontent.com"}, "login_failed"),
        ({"aud": ["someone-else", google_fake.CLIENT_ID]}, "login_failed"),
        ({"iss": "https://evil.example.com"}, "login_failed"),
        ({"exp": int(time.time()) - 3600, "iat": int(time.time()) - 7200}, "login_failed"),
        ({"nonce": "not-the-nonce"}, "login_failed"),
        ({"nonce": None}, "login_failed"),
        ({"sub": None}, "login_failed"),
        ({"email": None}, "login_failed"),
        ({"email_verified": False}, "email_not_verified"),
        ({"email_verified": "true"}, "email_not_verified"),
        ({"email": "stranger@example.com"}, "not_allowed"),
    ],
    ids=[
        "wrong-aud-with-our-azp",
        "multi-aud",
        "wrong-iss",
        "expired",
        "wrong-nonce",
        "missing-nonce",
        "missing-sub",
        "missing-email",
        "unverified-email",
        "string-email-verified",
        "not-on-allowlist",
    ],
)
async def test_bad_id_token_is_rejected(google, google_client, overrides, expected):
    # Our azp stays in every token, so only the named check can reject it.
    google.claim_overrides = overrides
    response = await sign_in(google_client, google)
    assert _error_code(response) == expected
    me = await google_client.get("/auth/session")
    assert me.status_code == 401
    assert me.json() == {"detail": "not_authenticated"}


