def _error_code(response) -> str | None:
    """The sign-in error code: a /login redirect with a web app, else JSON."""
{% if include_frontend %}    assert response.status_code == 302, response.text
    location = response.headers["location"]
    if not location.startswith("/login?"):
        return None
    return parse_qs(urlsplit(location).query)["error"][0]
{% else %}    assert response.status_code in (401, 403), response.text
    return response.json()["detail"]
{% endif %}

