async def test_require_scope_reads_scopes_or_scope(async_client):
    from fastapi import Depends
    from app.main import app

    route = "/__scope_check"

    @app.get(route)
    async def _scope_check(claims: dict = Depends(middleware.require_scope("write"))):
        return {"ok": True}

    try:
        assert (await async_client.get(route)).status_code == 200
    finally:
        app.router.routes = [r for r in app.router.routes if getattr(r, "path", "") != route]
