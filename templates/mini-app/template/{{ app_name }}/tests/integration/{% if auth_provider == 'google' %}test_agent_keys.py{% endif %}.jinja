GOOGLE_ID_TOKEN_SHAPE = "eyJhbGciOiJSUzI1NiIsImtpZCI6IjEifQ.eyJhdWQiOiJ4In0.c2ln"
LOGTO_TOKEN_SHAPE = "eyJhbGciOiJFUzM4NCIsImtpZCI6ImsifQ.eyJzdWIiOiJtMm0ifQ.c2ln"


@pytest.mark.parametrize(
    "authorization",
    [
        f"Bearer {GOOGLE_ID_TOKEN_SHAPE}",
        f"Bearer {LOGTO_TOKEN_SHAPE}",
        "Bearer ya29.a0AfH6SMfakeGoogleAccessToken",
        "Bearer agk.alice-read",
        "Bearer agk.Alice.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "Bearer agk.alice-read.short",
        "Basic YWxpY2U6c2VjcmV0",
        "Bearer",
    ],
)
async def test_non_agent_credentials_are_rejected(keys, google_client, authorization):
    response = await google_client.get(
        "/api/items", headers={"Authorization": authorization, ACTOR_HEADER: ALICE}
    )
    assert response.status_code == 401
    assert response.json() == {"detail": "invalid_agent_credential"}


async def test_wrong_secret_and_unknown_id_look_the_same(keys, google_client):
    _, key_id, secret = keys["alice_read"].split(".")
    wrong_secret = f"agk.{key_id}.{'A' * 43}"
    unknown_id = f"agk.nobody.{secret}"
    for key in (wrong_secret, unknown_id):
        response = await google_client.get("/api/items", headers=_headers(key, ALICE))
        assert response.status_code == 401
        assert response.json() == {"detail": "invalid_agent_credential"}


async def test_bearer_without_configured_keys(configured, google_client):
    response = await google_client.get(
        "/api/items", headers={"Authorization": f"Bearer {GOOGLE_ID_TOKEN_SHAPE}"}
    )
    assert response.status_code == 401
    assert response.json() == {"detail": "machine_auth_not_configured"}


async def test_bad_header_never_falls_back_to_the_session(google, google_client, keys):
    await sign_in(google_client, google)
    assert (await google_client.get("/api/items")).status_code == 200
    response = await google_client.get("/api/items", headers={"Authorization": "Bearer nope"})
    assert response.status_code == 401
    assert response.json() == {"detail": "invalid_agent_credential"}


async def test_expired_key_is_refused(configured, google_client, monkeypatch):
    key, entry = create_agent_key(key_id="old", actor=ALICE, write=False, expires=_future())
    entry["expires"] = "2020-01-01T00:00:00Z"
    monkeypatch.setattr(configured, "agent_credentials", json.dumps([entry]))
    response = await google_client.get("/api/items", headers=_headers(key, ALICE))
    assert response.status_code == 401
    assert response.json() == {"detail": "agent_credential_expired"}


def test_expiry_boundary_is_exact():
    key, entry = create_agent_key(key_id="edge", actor=ALICE, write=False, expires=_future())
    entry["expires"] = "2030-06-01T12:00:00Z"
    raw = json.dumps([entry])
    instant = datetime(2030, 6, 1, 12, 0, 0, tzinfo=UTC)

    def check(now):
        return agent_keys.authenticate(
            authorization=f"Bearer {key}", actor_header=ALICE, method="GET",
            raw_credentials=raw, now=now,
        )

    assert check(instant - timedelta(seconds=1))["sub"] == ALICE
    for now in (instant, instant + timedelta(seconds=1)):
        with pytest.raises(AgentKeyRejected) as exc:
            check(now)
        assert exc.value.detail == "agent_credential_expired"


# ---------------------------------------------------------------------------
# Malformed key lists fail closed for machines, not for people
# ---------------------------------------------------------------------------


def _entry(**changes) -> dict:
    entry = {"id": "k1", "sha256": hash_secret("x" * 43), "actor": ALICE, "scopes": ["read"]}
    entry.update(changes)
    return entry


@pytest.mark.parametrize(
    "raw",
    [
        "not json",
        json.dumps({"id": "k1"}),
        json.dumps(["k1"]),
        json.dumps([_entry(), _entry()]),
        json.dumps([_entry(), _entry(id="k2")]),
        json.dumps([_entry(extra="field")]),
        json.dumps([_entry(id="Bad_ID")]),
        json.dumps([_entry(sha256="ABC")]),
        json.dumps([_entry(sha256="F" * 64)]),
        json.dumps([_entry(actor="alice@example.com")]),
        json.dumps([_entry(scopes=["write"])]),
        json.dumps([_entry(scopes=["read", "admin"])]),
        json.dumps([_entry(scopes=["read", "read"])]),
        json.dumps([_entry(scopes="read")]),
        json.dumps([_entry(expires="2030-01-01")]),
        json.dumps([_entry(expires="2030-02-30T00:00:00Z")]),
        json.dumps([_entry(expires="2030-01-01T00:00:00+00:00")]),
        json.dumps([{k: v for k, v in _entry().items() if k != "actor"}]),
        json.dumps([{k: v for k, v in _entry().items() if k != "scopes"}]),
        json.dumps([_entry(id="k1\n")]),
        json.dumps([_entry(sha256=hash_secret("x" * 43) + "\n")]),
        json.dumps([_entry(actor=ALICE + "\n")]),
    ],
    ids=[
        "not-json", "not-a-list", "not-objects", "duplicate-id", "duplicate-hash",
        "unknown-field", "bad-id", "short-hash", "uppercase-hash", "email-actor",
        "write-without-read", "unknown-scope", "repeated-scope", "scope-string",
        "date-only-expiry", "impossible-date", "offset-not-z", "missing-actor",
        "missing-scopes", "newline-id", "newline-hash", "newline-actor",
    ],
)
async def test_malformed_key_list_rejects_machines_only(
    google, google_client, configured, monkeypatch, raw
):
    monkeypatch.setattr(configured, "agent_credentials", raw)
    key, _ = create_agent_key(key_id="k1", actor=ALICE, write=False, expires=None)
    response = await google_client.get("/api/items", headers=_headers(key, ALICE))
    assert response.status_code == 503
    assert response.json() == {"detail": "agent_credentials_invalid"}
    # Browser sign-in still works.
    await sign_in(google_client, google)
    assert (await google_client.get("/api/items")).status_code == 200


