def test_tool_writes_a_private_key_file_and_never_prints_the_key(tmp_path, capsys, caplog):
    caplog.set_level(logging.DEBUG)
    out = tmp_path / "laptop.agent-key"
    code = agent_keys.main(
        ["new", "--id", "laptop", "--actor", ALICE, "--out", str(out), "--expires", _future()]
    )
    assert code == 0
    captured = capsys.readouterr()
    key = out.read_text().strip()
    assert key.startswith("agk.laptop.") and len(key.split(".")[2]) == 43
    assert stat.S_IMODE(os.stat(out).st_mode) == 0o600
    for text in (captured.out, captured.err, caplog.text):
        assert key not in text and key.split(".")[2] not in text
    result = json.loads(captured.out)
    assert result["key_file"] == str(out.resolve())
    assert result["entry"]["sha256"] == hash_secret(key.split(".")[2])
    assert result["entry"]["scopes"] == ["read"]
    assert agent_keys.parse_agent_credentials(json.dumps([result["entry"]]))


def test_tool_grants_write_only_when_asked(tmp_path, capsys):
    out = tmp_path / "w.agent-key"
    args = ["new", "--id", "w", "--actor", ALICE, "--out", str(out), "--write"]
    assert agent_keys.main(args) == 0
    assert json.loads(capsys.readouterr().out)["entry"]["scopes"] == ["read", "write"]


def test_tool_refuses_to_overwrite_or_follow_a_symlink(tmp_path, capsys):
    existing = tmp_path / "taken.agent-key"
    existing.write_text("keep me")
    assert agent_keys.main(["new", "--id", "a", "--actor", ALICE, "--out", str(existing)]) == 2
    assert existing.read_text() == "keep me"

    target = tmp_path / "elsewhere"
    link = tmp_path / "link.agent-key"
    link.symlink_to(target)
    assert agent_keys.main(["new", "--id", "a", "--actor", ALICE, "--out", str(link)]) == 2
    assert not target.exists()
    assert "agk." not in capsys.readouterr().out


@pytest.mark.parametrize(
    "args",
    [
        ["--id", "Bad_Id", "--actor", ALICE],
        ["--id", "ok", "--actor", "alice@example.com"],
        ["--id", "ok", "--actor", ALICE, "--expires", "2020-01-01T00:00:00Z"],
        ["--id", "ok", "--actor", ALICE, "--expires", "tomorrow"],
    ],
)
def test_tool_rejects_bad_input_without_creating_a_file(tmp_path, args):
    out = tmp_path / "x.agent-key"
    assert agent_keys.main(["new", *args, "--out", str(out)]) == 2
    assert not out.exists()


def test_tool_runs_as_a_module(tmp_path):
    out = tmp_path / "m.agent-key"
    result = subprocess.run(
        [sys.executable, "-m", "app.auth.agent_keys", "new", "--id", "m", "--actor", ALICE,
         "--out", str(out)],
        capture_output=True, text=True, check=True, env={**os.environ, "PYTHONPATH": os.getcwd()},
    )
    key = out.read_text().strip()
    assert key not in result.stdout and key not in result.stderr
    assert json.loads(result.stdout)["entry"]["id"] == "m"
