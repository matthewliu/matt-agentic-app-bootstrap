"""Agent keys: the machine credential for the per-app CLI and MCP server.

These tests use the REAL `validate_token` through HTTP, with dummy keys made
by the same function the operator tool uses.
"""

import json
import logging
import os
import stat
import subprocess
import sys
from datetime import UTC, datetime, timedelta

import pytest

from app.auth import agent_keys
from app.auth.agent_keys import AgentKeyRejected, create_agent_key, hash_secret
from tests import google_fake
from tests.google_fake import sign_in

ACTOR_HEADER = "X-{{ app_name | replace('-', '_') | upper }}-Actor-Sub"
ALICE = "google:1111"
BOB = "google:2222"


def _future(days: int = 30) -> str:
    return (datetime.now(UTC) + timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ")


@pytest.fixture
def keys(configured, monkeypatch) -> dict[str, str]:
    """Three keys: Alice read-only, Alice read+write, Bob read+write."""
    made = {}
    entries = []
    for name, key_id, actor, write in [
        ("alice_read", "alice-read", ALICE, False),
        ("alice_write", "alice-write", ALICE, True),
        ("bob_write", "bob-write", BOB, True),
    ]:
        key, entry = create_agent_key(key_id=key_id, actor=actor, write=write, expires=_future())
        made[name] = key
        entries.append(entry)
    monkeypatch.setattr(configured, "agent_credentials", json.dumps(entries))
    return made


def _headers(key: str, actor: str | None) -> dict[str, str]:
    headers = {"Authorization": f"Bearer {key}"}
    if actor is not None:
        headers[ACTOR_HEADER] = actor
    return headers


# ---------------------------------------------------------------------------
# Ownership and scope
# ---------------------------------------------------------------------------


async def test_read_key_reads_but_cannot_write(keys, google_client):
    read = _headers(keys["alice_read"], ALICE)
    assert (await google_client.get("/api/items", headers=read)).status_code == 200
    writes = [("POST", "/api/items"), ("PUT", "/api/items/x"), ("DELETE", "/api/items/x")]
    for method, path in writes:
        response = await google_client.request(method, path, headers=read, json={"name": "x"})
        assert response.status_code == 403, (method, response.text)
        assert response.json() == {"detail": "missing_scope"}


async def test_write_key_creates_items_owned_by_its_actor(keys, google_client):
    write = _headers(keys["alice_write"], ALICE)
    created = await google_client.post("/api/items", json={"name": "from-agent"}, headers=write)
    assert created.status_code == 201, created.text
    me = await google_client.get("/auth/session", headers=write)
    assert me.json() == {
        "user_id": ALICE,
        "auth_method": "agent_key",
        "scopes": ["read", "write"],
    }


async def test_key_for_alice_cannot_reach_bobs_data(keys, google_client):
    bob = _headers(keys["bob_write"], BOB)
    made = await google_client.post("/api/items", json={"name": "bob-secret"}, headers=bob)
    assert made.status_code == 201
    bob_item = made.json()["id"]

    alice = _headers(keys["alice_write"], ALICE)
    listed = await google_client.get("/api/items", headers=alice)
    assert listed.status_code == 200
    assert listed.json() == []
    assert (await google_client.get(f"/api/items/{bob_item}", headers=alice)).status_code == 404

    as_bob = await google_client.get("/api/items", headers=_headers(keys["alice_write"], BOB))
    assert as_bob.status_code == 403
    assert as_bob.json() == {"detail": "actor_mismatch"}


async def test_agent_and_browser_share_the_same_user(
    google, google_client, configured, monkeypatch
):
    key, entry = create_agent_key(
        key_id="owner-cli", actor=google_fake.OWNER_ID, write=True, expires=None
    )
    monkeypatch.setattr(configured, "agent_credentials", json.dumps([entry]))
    made = await google_client.post(
        "/api/items", json={"name": "by-agent"}, headers=_headers(key, google_fake.OWNER_ID)
    )
    assert made.status_code == 201
    await sign_in(google_client, google)
    listed = await google_client.get("/api/items")
    assert [item["name"] for item in listed.json()] == ["by-agent"]


async def test_allowlist_removal_does_not_revoke_agent_keys(keys, google_client, configured,
                                                            monkeypatch):
    """Documented limit: an agent key has no email, so removing the person
    from AUTH_ALLOWED_EMAILS does not stop it. Remove the person's entries
    from AGENT_CREDENTIALS as well."""
    monkeypatch.setattr(configured, "auth_allowed_emails", "nobody@example.com")
    response = await google_client.get("/api/items", headers=_headers(keys["alice_read"], ALICE))
    assert response.status_code == 200
    monkeypatch.setattr(configured, "agent_credentials", "[]")
    response = await google_client.get("/api/items", headers=_headers(keys["alice_read"], ALICE))
    assert response.status_code == 401
    assert response.json() == {"detail": "machine_auth_not_configured"}


async def test_missing_actor_header_is_refused(keys, google_client):
    response = await google_client.get("/api/items", headers=_headers(keys["alice_read"], None))
    assert response.status_code == 403
    assert response.json() == {"detail": "missing_actor_sub_header"}


async def test_agent_write_needs_no_csrf_token(keys, google_client):
    response = await google_client.post(
        "/api/items", json={"name": "x"}, headers=_headers(keys["alice_write"], ALICE)
    )
    assert response.status_code == 201


