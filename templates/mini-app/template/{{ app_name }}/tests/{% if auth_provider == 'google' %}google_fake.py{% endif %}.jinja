"""A fake Google OpenID provider and helpers for the auth tests.

The fake answers discovery, JWKS, and token requests through an
httpx2.MockTransport, so no test reaches the network. It signs ID tokens with
a key made for each test run.
"""

import base64
import hashlib
import json
import time
from urllib.parse import parse_qs, urlsplit

import httpx2
import jwt
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from jwt.algorithms import RSAAlgorithm
from httpx import AsyncClient, Response

from app.routes import auth as auth_routes

CLIENT_ID = "test-client.apps.googleusercontent.com"
CLIENT_SECRET = "test-client-secret"
SESSION_SECRET = "s" * 48
BASE_URL = "http://localhost:8000"
OWNER_EMAIL = "owner@example.com"
OWNER_SUB = "1234567890"
OWNER_ID = f"google:{OWNER_SUB}"

ISSUER = "https://accounts.google.com"
AUTHORIZE_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
JWKS_URL = "https://www.googleapis.com/oauth2/v3/certs"


def _new_private_key():
    return rsa.generate_private_key(public_exponent=65537, key_size=2048)


def _pem(private_key) -> bytes:
    return private_key.private_bytes(
        serialization.Encoding.PEM,
        serialization.PrivateFormat.PKCS8,
        serialization.NoEncryption(),
    )


class FakeGoogle:
    """Plays Google for one test. Change the fields to make it misbehave."""

    def __init__(self) -> None:
        self.key = _new_private_key()
        self.kid = "fake-kid"
        self.signing_key = self.key
        self.claim_overrides: dict = {}
        self.omit_id_token = False
        self.authorize_params: dict[str, str] = {}
        self.token_requests: list[dict[str, str]] = []

    def jwks(self) -> dict:
        jwk = json.loads(RSAAlgorithm.to_jwk(self.key.public_key()))
        jwk.update({"kid": self.kid, "alg": "RS256", "use": "sig"})
        return {"keys": [jwk]}

    def id_token(self) -> str:
        now = int(time.time())
        claims = {
            "iss": ISSUER,
            "aud": CLIENT_ID,
            "azp": CLIENT_ID,
            "sub": OWNER_SUB,
            "email": OWNER_EMAIL,
            "email_verified": True,
            "iat": now,
            "exp": now + 3600,
            "nonce": self.authorize_params.get("nonce"),
        }
        for name, value in self.claim_overrides.items():
            if value is None:
                claims.pop(name, None)
            else:
                claims[name] = value
        return jwt.encode(
            claims, _pem(self.signing_key), algorithm="RS256", headers={"kid": self.kid}
        )

    def handler(self, request: httpx2.Request) -> httpx2.Response:
        url = str(request.url).split("?")[0]
        if url == auth_routes.GOOGLE_DISCOVERY_URL:
            return httpx2.Response(
                200,
                json={
                    "issuer": ISSUER,
                    "authorization_endpoint": AUTHORIZE_URL,
                    "token_endpoint": TOKEN_URL,
                    "jwks_uri": JWKS_URL,
                    "id_token_signing_alg_values_supported": ["RS256"],
                },
            )
        if url == JWKS_URL:
            return httpx2.Response(200, json=self.jwks())
        if url == TOKEN_URL and request.method == "POST":
            form = {k: v[0] for k, v in parse_qs(request.content.decode()).items()}
            self.token_requests.append(form)
            # The client secret travels to Google only, in the Basic header.
            expected_basic = base64.b64encode(f"{CLIENT_ID}:{CLIENT_SECRET}".encode()).decode()
            if request.headers.get("authorization") != f"Basic {expected_basic}":
                return httpx2.Response(401, json={"error": "invalid_client"})
            # PKCE: the verifier must hash to the challenge from /auth/login.
            verifier = form.get("code_verifier", "")
            challenge = (
                base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest())
                .decode()
                .rstrip("=")
            )
            if challenge != self.authorize_params.get("code_challenge"):
                return httpx2.Response(400, json={"error": "invalid_grant"})
            body = {
                "access_token": "ya29.fake-access-token",
                "token_type": "Bearer",
                "expires_in": 3600,
                "scope": "openid email",
            }
            if not self.omit_id_token:
                body["id_token"] = self.id_token()
            return httpx2.Response(200, json=body)
        raise AssertionError(f"unexpected request to {request.url}")


async def start_login(client: AsyncClient, google: FakeGoogle, next_path: str = "/") -> dict:
    response = await client.get("/auth/login", params={"next": next_path})
    assert response.status_code == 302, response.text
    location = response.headers["location"]
    assert location.startswith(AUTHORIZE_URL)
    params = {k: v[0] for k, v in parse_qs(urlsplit(location).query).items()}
    google.authorize_params = params
    return params


async def sign_in(client: AsyncClient, google: FakeGoogle, next_path: str = "/") -> Response:
    params = await start_login(client, google, next_path)
    return await client.get(
        "/auth/callback", params={"code": "fake-code", "state": params["state"]}
    )


async def csrf_token(client: AsyncClient) -> str:
    response = await client.get("/auth/session")
    assert response.status_code == 200, response.text
    return response.json()["csrf_token"]
