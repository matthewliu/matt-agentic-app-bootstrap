"""Guard render.yaml against two unsafe edits.

Render applies render.yaml to live infrastructure when it is merged to main.
These checks fail CI before an unsafe Blueprint reaches Render:

- A database without `ipAllowList: []` accepts connections from any IP address.
- An env var with a literal `value` puts that value in git. Render also passes
  every service env var to the Docker build. The check flags a literal `value`
  when the key looks like a secret or a connection string (SECRET_SUFFIXES),
  or when the value contains "://" (a URL can carry credentials). Declare
  secrets with `sync: false` and set them in the Render dashboard. Literal
  values such as `LOG_LEVEL: info` stay allowed.
"""

from pathlib import Path

import yaml

BLUEPRINT = Path(__file__).resolve().parents[2] / "render.yaml"
SECRET_SUFFIXES = (
    "SECRET", "_KEY", "TOKEN", "PASSWORD", "PASSPHRASE", "_URL", "_URI", "_DSN",
)


def _blueprint() -> dict:
    return yaml.safe_load(BLUEPRINT.read_text()) or {}


def _env_vars(blueprint: dict) -> list[dict]:
    env_vars = []
    for owner in (blueprint.get("services") or []) + (blueprint.get("envVarGroups") or []):
        env_vars.extend(owner.get("envVars") or [])
    return env_vars


def test_every_database_blocks_external_connections():
    for db in _blueprint().get("databases") or []:
        assert db.get("ipAllowList") == [], (
            f"database {db.get('name')!r} must set ipAllowList: [] "
            f"(a missing ipAllowList allows every IP address)"
        )


def _is_leaked(var: dict) -> bool:
    if "value" not in var:
        return False
    if str(var.get("key", "")).upper().endswith(SECRET_SUFFIXES):
        return True
    value = var["value"]
    return isinstance(value, str) and "://" in value


def test_no_secret_has_a_literal_value():
    leaked = [var.get("key") for var in _env_vars(_blueprint()) if _is_leaked(var)]
    assert not leaked, f"secret env vars with a literal value in render.yaml: {leaked}"
{%- if auth_provider == 'google' %}


GOOGLE_SECRETS = ("GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "AUTH_ALLOWED_EMAILS",
                  "AGENT_CREDENTIALS")


def test_google_settings_are_declared_without_values():
    by_key = {var.get("key"): var for var in _env_vars(_blueprint())}
    for key in GOOGLE_SECRETS:
        assert key in by_key, f"{key} must be declared so Render asks for it"
        assert by_key[key].get("sync") is False and "value" not in by_key[key], (
            f"{key} must use sync: false and carry no value"
        )
    session = by_key.get("SESSION_SECRET")
    assert session == {"key": "SESSION_SECRET", "generateValue": True}, (
        "SESSION_SECRET must be generated by Render, never written in git"
    )
