class TestItemsCommands:
    def test_list_json(self, fake_api):
        rec = fake_api(httpx.Response(200, json=[ITEM]))
        result = runner.invoke(cli_app, ["--json", "items", "list", "--limit", "5"])
        assert result.exit_code == 0, result.output
        assert json.loads(result.stdout)["items"][0]["id"] == ITEM_ID
        assert rec.requests[0].url.params["limit"] == "5"

    def test_json_flag_after_the_command(self, fake_api):
        fake_api(httpx.Response(200, json=[ITEM]))
        result = runner.invoke(cli_app, ["items", "list", "--json"])
        assert result.exit_code == 0, result.output
        assert json.loads(result.stdout)["items"][0]["id"] == ITEM_ID

    def test_delete_refusal_honors_trailing_json_flag(self, fake_api):
        fake_api(httpx.Response(204))
        result = runner.invoke(cli_app, ["items", "delete", ITEM_ID, "--json"])
        assert result.exit_code == 1
        assert json.loads(result.stdout)["error_code"] == "confirmation_required"

    def test_update_with_name_only_keeps_description(self, fake_api):
        rec = fake_api(httpx.Response(200, json=ITEM))
        result = runner.invoke(cli_app, ["--json", "items", "update", ITEM_ID, "--name", "New"])
        assert result.exit_code == 0, result.output
        assert json.loads(rec.requests[0].content) == {"name": "New"}

    def test_delete_needs_yes(self, fake_api):
        rec = fake_api(httpx.Response(204))
        result = runner.invoke(cli_app, ["--json", "items", "delete", ITEM_ID])
        assert result.exit_code == 1
        assert json.loads(result.stdout)["error_code"] == "confirmation_required"
        assert rec.requests == []

    def test_delete_with_yes(self, fake_api):
        fake_api(httpx.Response(204))
        result = runner.invoke(cli_app, ["--json", "items", "delete", ITEM_ID, "--yes"])
        assert result.exit_code == 0, result.output
        assert json.loads(result.stdout) == {"deleted": True, "item_id": ITEM_ID}

    def test_bad_id_exits_1(self, fake_api):
        rec = fake_api(httpx.Response(200, json=ITEM))
        result = runner.invoke(cli_app, ["--json", "items", "get", "not-a-uuid"])
        assert result.exit_code == 1
        assert json.loads(result.stdout)["error_code"] == "invalid_input"
        assert rec.requests == []

    def test_not_found_json_envelope(self, fake_api):
        fake_api(httpx.Response(404, json={"detail": "Not found"}))
        result = runner.invoke(cli_app, ["--json", "items", "get", str(uuid.uuid4())])
        assert result.exit_code == 3
        envelope = json.loads(result.stdout)
        assert envelope["status"] == "failed"
        assert envelope["error_code"] == "not_found"
        assert envelope["checkpoint"] == "items_get"

    def test_missing_config_exits_5(self):
        result = runner.invoke(cli_app, ["--json", "items", "list"])
        assert result.exit_code == 5
        assert json.loads(result.stdout)["error_code"] == "misconfigured"


class TestAgentContext:
    @pytest.mark.parametrize("argv", [["agent-context", "--json"], ["--json", "agent-context"]])
    def test_lists_operations(self, argv):
        result = runner.invoke(cli_app, argv)
        assert result.exit_code == 0, result.output
        envelope = json.loads(result.stdout)
        ids = {op["id"] for op in envelope["operations"]}
        assert {"items_list", "items_get", "items_create", "items_update", "items_delete"} <= ids
        assert envelope["auth"]["required_env_vars"]
