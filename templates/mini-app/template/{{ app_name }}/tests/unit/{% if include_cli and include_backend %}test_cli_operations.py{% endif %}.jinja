class TestOperationsContract:
    def test_every_operation_matches_an_openapi_operation(self):
        spec = api_app.openapi()
        by_id = {
            op["operationId"]: (method.upper(), path)
            for path, methods in spec["paths"].items()
            for method, op in methods.items()
            if "operationId" in op
        }
        for op in operations.OPERATIONS.values():
            assert by_id.get(op.id) == (op.method, op.path), op.id

    def test_list_limits_match_the_route(self):
        spec = api_app.openapi()
        params = {
            p["name"]: p["schema"] for p in spec["paths"]["/api/items"]["get"]["parameters"]
        }
        model = operations.ItemsListInput.model_json_schema()["properties"]
        assert params["skip"]["minimum"] == model["skip"]["minimum"]
        assert params["limit"]["minimum"] == model["limit"]["minimum"]
        assert params["limit"]["maximum"] == model["limit"]["maximum"]

    def test_operations_never_touch_the_database(self):
        tree = ast.parse(inspect.getsource(operations))
        imported = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.ImportFrom) and node.module:
                imported.add(node.module)
            elif isinstance(node, ast.Import):
                imported.update(a.name for a in node.names)
        forbidden = {m for m in imported if m.startswith(("app.db", "app.services", "sqlalchemy"))}
        assert forbidden == set()

    def test_delete_is_never_an_mcp_tool(self):
        assert operations.OPERATIONS["items_delete"].mcp_tool is False
        assert operations.OPERATIONS["items_delete"].access == "destructive"

    def test_describe_lists_schemas(self):
        described = {d["id"]: d for d in operations.describe()}
        assert set(described) == set(operations.OPERATIONS)
        assert described["items_list"]["input_schema"]["properties"]["limit"]["maximum"] == 100
        assert described["items_list"]["mcp_exposure"] == "default"
        assert described["items_create"]["mcp_exposure"] == "opt_in"
        assert described["items_delete"]["mcp_exposure"] == "never"
        assert "items" in described["items_list"]["output_schema"]["properties"]


class TestOperationsRun:
    @pytest.mark.parametrize(
        ("op_id", "payload"),
        [
            ("items_list", {"limit": 0}),
            ("items_list", {"limit": 5, "user_id": "someone-else"}),
            ("items_get", {"item_id": "../../admin"}),
            ("items_update", {"item_id": ITEM_ID}),
            ("items_update", {"item_id": ITEM_ID, "name": None}),
            ("items_create", {"name": ""}),
        ],
    )
    def test_invalid_input_sends_nothing(self, op_id, payload):
        rec = Recorder(httpx.Response(200, json=ITEM))
        with pytest.raises({{ AppCls }}ClientError) as exc:
            operations.run(op_id, make_client(rec), payload)
        assert exc.value.exit_code == 1
        assert exc.value.error_code == "invalid_input"
        assert rec.requests == []

    def test_list_wraps_items_and_sends_query(self):
        rec = Recorder(httpx.Response(200, json=[ITEM]))
        out = operations.run("items_list", make_client(rec), {"limit": 5})
        assert out["items"][0]["id"] == ITEM_ID
        assert rec.requests[0].url.params["limit"] == "5"
        assert rec.requests[0].url.params["skip"] == "0"

    def test_update_sends_only_given_fields(self):
        rec = Recorder(httpx.Response(200, json=ITEM))
        operations.run("items_update", make_client(rec), {"item_id": ITEM_ID, "name": "New"})
        assert json.loads(rec.requests[0].content) == {"name": "New"}
        assert rec.requests[0].url.path == f"/api/items/{ITEM_ID}"

    def test_delete_returns_a_typed_result(self):
        rec = Recorder(httpx.Response(204))
        out = operations.run("items_delete", make_client(rec), {"item_id": ITEM_ID})
        assert out == {"deleted": True, "item_id": ITEM_ID}
        assert rec.requests[0].method == "DELETE"

    def test_unexpected_response_is_invalid_response(self):
        rec = Recorder(httpx.Response(200, json={"surprise": True}))
        with pytest.raises({{ AppCls }}ClientError) as exc:
            operations.run("items_get", make_client(rec), {"item_id": ITEM_ID})
        assert exc.value.error_code == "invalid_response"


