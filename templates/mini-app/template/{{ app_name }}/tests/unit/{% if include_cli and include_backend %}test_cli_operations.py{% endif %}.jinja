class TestClientRequests:
    def test_actor_header_matches_the_server(self):
        from app.auth import middleware

        # Header lookup ignores case, but a hyphen never matches an underscore.
        assert {{ AppCls }}Client.ACTOR_SUB_HEADER.lower() == middleware.ACTOR_SUB_HEADER.lower()

    def test_sends_bearer_and_actor_headers(self):
        rec = Recorder(httpx.Response(200, json=[]))
        make_client(rec).get("/api/items")
        sent = rec.requests[0]
        assert sent.headers["Authorization"] == f"Bearer {DUMMY_TOKEN}"
        assert sent.headers[{{ AppCls }}Client.ACTOR_SUB_HEADER] == ACTOR

    @pytest.mark.parametrize(
        ("status", "detail"),
        [
            (503, "auth_not_configured"),
            (401, "machine_auth_not_configured"),
            (503, "agent_credentials_invalid"),
            (401, "invalid_agent_credential"),
            (401, "agent_credential_expired"),
            (403, "missing_actor_sub_header"),
            (403, "actor_mismatch"),
            (403, "missing_scope"),
            (403, "actor_sub_not_allowed"),
        ],
    )
    def test_server_detail_becomes_error_code(self, status, detail):
        rec = Recorder(httpx.Response(status, json={"detail": detail}))
        with pytest.raises({{ AppCls }}ClientError) as exc:
            make_client(rec, FakeTokens(refreshable=False)).get("/api/items")
        assert exc.value.error_code == detail
        assert exc.value.status_code == status
        assert exc.value.exit_code == (2 if status == 401 else 3)

    def test_detail_with_newline_is_not_an_error_code(self):
        rec = Recorder(httpx.Response(403, json={"detail": "actor_mismatch\n"}))
        with pytest.raises({{ AppCls }}ClientError) as exc:
            make_client(rec, FakeTokens(refreshable=False)).get("/api/items")
        assert exc.value.error_code == "forbidden"

    def test_free_text_detail_falls_back_to_status_code(self):
        rec = Recorder(httpx.Response(404, json={"detail": "Not found"}))
        with pytest.raises({{ AppCls }}ClientError) as exc:
            make_client(rec).get("/api/items/x")
        assert exc.value.error_code == "not_found"

    def test_static_key_is_not_retried_on_401(self):
        rec = Recorder(httpx.Response(401, json={"detail": "invalid_agent_credential"}))
        with pytest.raises({{ AppCls }}ClientError):
            make_client(rec, FakeTokens(refreshable=False)).get("/api/items")
        assert len(rec.requests) == 1

    def test_refreshable_token_is_retried_once_on_401(self):
        tokens = FakeTokens(refreshable=True)
        rec = Recorder(httpx.Response(401, json={"detail": "expired"}))
        with pytest.raises({{ AppCls }}ClientError) as exc:
            make_client(rec, tokens).get("/api/items")
        assert len(rec.requests) == 2
        assert tokens.invalidated == 1
        assert exc.value.error_code == "expired"

    @pytest.mark.parametrize("secret", [DUMMY_TOKEN, DUMMY_AGENT_KEY])
    @pytest.mark.parametrize("padding", [0, 190], ids=["whole", "cut-by-truncation"])
    def test_reflected_credential_is_redacted(self, secret, padding):
        # padding=190 puts the 200-character cut inside the secret.
        body = "x" * padding + f"{secret} rejected"
        rec = Recorder(httpx.Response(400, text=body))
        with pytest.raises({{ AppCls }}ClientError) as exc:
            make_client(rec, FakeTokens(token=secret)).get("/api/items")
        assert secret[:10] not in exc.value.message
        assert secret[:10] not in str(exc.value)

    def test_transport_error_is_a_network_error(self):
        def boom(request):
            raise httpx.ConnectError("refused", request=request)

        with pytest.raises({{ AppCls }}ClientError) as exc:
            make_client(boom).get("/api/items")
        assert exc.value.exit_code == 4
        assert exc.value.error_code == "network_error"


