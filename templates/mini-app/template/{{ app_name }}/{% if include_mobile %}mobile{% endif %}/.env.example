# Mobile environment variables (EXPO_PUBLIC_* are inlined at bundle time)
# Copy to .env and fill in real values. For EAS builds, set in eas.json env blocks.
EXPO_PUBLIC_API_BASE_URL=https://your-app.up.railway.app
EXPO_PUBLIC_LOGTO_ENDPOINT=https://your-logto-instance.up.railway.app
EXPO_PUBLIC_LOGTO_APP_ID=your-native-app-id
EXPO_PUBLIC_LOGTO_API_RESOURCE=https://your-app.up.railway.app/api
