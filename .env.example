# agentic-core settings. The default path (Google sign-in, Render) needs
# nothing in this file: log in once with `gh auth login` and `render login`.
# Fill in a section below only if you choose that option.
#
# The CLI reads ./.env, then ~/.agentic-apps.env (optional, chmod 600).
# Values exported in your shell win over both files.

# --- Logto sign-in (optional; see docs/logto-setup-guide.md) ---------------
# LOGTO_ENDPOINT=https://your-logto-instance.example.com
# LOGTO_M2M_APP_ID=your-m2m-app-id
# LOGTO_M2M_APP_SECRET=your-m2m-app-secret   # move into the keystore, then delete
# PLATFORM_DOMAIN=your-domain.example        # API identifiers: https://<app>.<domain>/api
# LOGTO_API_RESOURCE=https://test-app.your-domain.example/api   # scripts/verify-logto only

# --- Railway hosting (optional; Render is the default) ---------------------
# RAILWAY_API_TOKEN=your-railway-api-token
# RAILWAY_WORKSPACE=your-workspace-name      # or pass --railway-workspace
